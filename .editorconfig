# Top-most EditorConfig file - stops looking up parent directories
root = true

# All files configuration
[*]
indent_style = space
indent_size = 4
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

# C# Code Layout and Formatting Rules
[*.cs]
# Organize using directives: Place System namespaces first, alphabetically sorted
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# Modern C# Language Feature Enforcement
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion

# Code Block Formatting Gates
csharp_new_line_before_open_brace = all
csharp_space_after_keywords_in_control_flow_statements = true